# ==============================================================================
# AI Commerce Agent - Environment Configuration (.env.example)
# ==============================================================================

# Application Environment Mode (development, test, production)
ENVIRONMENT=development

# Debug Mode (true for development, false for production)
DEBUG=true

# Frontend Allowed Origins for CORS (comma-separated or JSON array)
# Development defaults: http://localhost:3000,http://127.0.0.1:3000
# In production, specify exact trusted domain(s). Wildcard '*' is strictly rejected.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Database Configuration (PostgreSQL / Supabase)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
SUPABASE_PUBLISHABLE_KEY=your_supabase_anon_key_placeholder

# AI Configuration (mock, openai, groq, gemini)
AI_PROVIDER=mock
AI_MODEL=gpt-4o-mini
AI_API_KEY=
AI_BASE_URL=

# Razorpay Payment Gateway Configuration
RAZORPAY_KEY_ID=rzp_test_placeholder
RAZORPAY_KEY_SECRET=your_razorpay_secret_placeholder
RAZORPAY_CURRENCY=INR
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_placeholder

# Agent-to-Agent Commerce Configuration (Phase 15 & 17E)
COMMERCE_AGENT_KEY=your_production_agent_key_min_16_chars_placeholder

# JWT Authentication Configuration (Phase 17)
JWT_SECRET_KEY=your_production_jwt_secret_min_32_chars_placeholder
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

