		{
			"name": "Search Products (headphone)",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code is 200\", function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"",
							"var jsonData = pm.response.json();",
							"pm.test(\"Search results match keyword\", function () {",
							"    pm.expect(jsonData.total).to.be.at.least(1);",
							"    var found = jsonData.items.some(function(item) {",
							"        return item.name.toLowerCase().includes(\"headphone\") || ",
							"               (item.description && item.description.toLowerCase().includes(\"headphone\"));",
							"    });",
							"    pm.expect(found).to.be.true;",
							"});"
						],
						"type": "text/javascript"
