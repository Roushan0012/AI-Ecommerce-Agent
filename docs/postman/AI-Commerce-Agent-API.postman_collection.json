							"var jsonData = pm.response.json();",
							"pm.test(\"Response contains pagination fields\", function () {",
							"    pm.expect(jsonData).to.have.property(\"items\");",
							"    pm.expect(jsonData).to.have.property(\"total\");",
							"    pm.expect(jsonData).to.have.property(\"page\");",
							"    pm.expect(jsonData).to.have.property(\"page_size\");",
							"    pm.expect(jsonData.total).to.be.at.least(12);",
							"});",
							"",
							"if (jsonData.items && jsonData.items.length > 0) {",
							"    pm.collectionVariables.set(\"first_product_id\", jsonData.items[0].id);",
							"}"
						],
						"type": "text/javascript"
