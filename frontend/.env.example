# ==============================================================================
# AI Commerce Agent Frontend - Production Environment Configuration (.env.example)
# ==============================================================================

# Backend API Service Base URL (without trailing slash)
# - Local development default: http://127.0.0.1:8000
# - Production deployment: https://api.yourdomain.com
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000

# Razorpay Public Key ID (for client-side Razorpay Checkout modal)
# - Use rzp_test_* for development/staging testing
# - Use rzp_live_* for production
# SECURITY WARNING: NEVER put RAZORPAY_KEY_SECRET, RAZORPAY_WEBHOOK_SECRET,
# JWT_SECRET_KEY, DATABASE_URL, or COMMERCE_AGENT_KEY in frontend env files!
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_placeholder
